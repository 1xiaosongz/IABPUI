QTabBar::tab {
    width: 176px;          /* 每个标签的固定宽度 */
    height: 66px;          /* 每个标签的固定高度 */

}

QTabWidget {
    background: transparent;
}
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    border: none;
    background-image: url(:/Set/Group 10802.png);
    background-repeat: no-repeat;
    background-position: center;
    color: rgb(255,255,255);
    font-family: "Source Han Sans CN";
    font-size: 30px;
    font-weight: bold;
    text-align: center;
}
QTabBar::tab:selected {
    background-image: url(:/Set/Group 10810.png);
}
QTabBar::tab:pressed {
    background-image: url(:/Set/Group 10802.png);
}
QTabBar::tab {
    margin-right: 10px;
}

QTabWidget::pane {
    border:none;
    background-image:url(:/Set/Group 10783.png);
    background-repeat:no-repeat;
    background-position:center;
}
