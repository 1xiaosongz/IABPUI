/* 1. 垂直滚动条整体轨道（Background Area） */
QScrollArea #scrollArea QScrollBar:vertical {
    background: #1E1E1E;        /* 滚动条背景色 */
    width: 10px;                /* 滚动条宽度 */
    margin: 0px 0px 0px 0px;    /* 外边距 */
    border: none;               /* 边框置空 */
}

/* 2. 滚动条滑块（The Scroll Handle） */
QScrollArea #scrollArea QScrollBar::handle:vertical {
    background: #666666;        /* 滑块默认状态颜色 */
    min-height: 40px;           /* 滑块最小高度，防止内容极多时滑块变得太小 */
    border-radius: 5px;         /* 圆角半径：设为宽度的一半，滑块会呈现胶囊状 */
}

/* 3. 鼠标悬停在滑块上时的状态（Hover） */
QScrollArea #scrollArea QScrollBar::handle:vertical:hover {
    background: #888888;        /* 悬停时颜色变亮 */
}

/* 4. 鼠标点击并拖拽滑块时的状态（Pressed） */
QScrollArea #scrollArea QScrollBar::handle:vertical:pressed {
    background: #AAAAAA;        /* 点击时颜色进一步变亮 */
}

/* 5. 隐藏滚动条上下两端的箭头按钮（Add-line 和 Sub-line） */
QScrollArea #scrollArea QScrollBar::add-line:vertical,
QScrollArea #scrollArea QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

/* 6. 隐藏滑块上下两侧空白轨道的点击高亮（Add-page 和 Sub-page） */
QScrollArea #scrollArea QScrollBar::add-page:vertical,
QScrollArea #scrollArea QScrollBar::sub-page:vertical {
    background: none;
}








