/* ======================== 基础样式 ======================== */

QPushButton {
    outline: none;
    border: none;
    background-repeat: no-repeat;
    background-position: center;
    background-color: transparent;
}

QLabel {
    border: none;
    background-repeat: no-repeat;
    background-position: center;
    background-color: transparent;
    font-family: "Source Han Sans CN";
    font-weight: bold;
}

QLabel[mode="Label_No_background"],
QPushButton#PushButton_No_background {
    background-image: none;
}

/* ======================== 字体大小 ======================== */

QLabel[mode="160px,colour22,226,58"]                                              { font-size: 160px; }
QLabel[mode="100px,colour252,86,78"],
QLabel[mode="100px,colour63,184,248"]                                             { font-size: 100px; }
QLabel[mode="80px,colour252,86,78"]                                               { font-size: 80px; }
QLabel[mode="60px,colour172,181,197"]                                             { font-size: 60px; }
QLabel[mode="40px,colour4,255,255"],
QLabel[mode="40px,colour255,255,255"],
QLabel[mode="40px,colour4,255,255,AlignCenter"],
QLabel[mode="40px,colour255,255,255,AlignCenter"]                                 { font-size: 40px; }
QLabel[mode="38px,colour4,255,255"],
QLabel[mode="38px,colour255,255,255"],
QLabel[mode="38px,colour4,255,255,AlignCenter"],
QLabel[mode="38px,colour255,255,255,AlignCenter"]                                 { font-size: 38px; }
QLabel[mode="30px,colour4,255,255"],
QLabel[mode="30px,colour255,255,255"],
QLabel[mode="30px,colour255,255,255,font-weight: normal"],
QLabel[mode="30px,colour172,181,197,AlignRight"]                                  { font-size: 30px; }
QLabel[mode="20px,colour172,181,197"],
QLabel[mode="20px,colour172,181,197,AlignLeft"],
QLabel[mode="20px,colour172,181,197,AlignTop"],
QLabel[mode="20px,colour255,255,255"],
QLabel[mode="20px,colour216,225,234"],
QLabel[mode="20px,colour255,255,255,114"]                                         { font-size: 20px; }
QLabel[mode="18px,colour172,181,197"]                                             { font-size: 18px; }

/* ======================== 字体颜色 ======================== */

/* 青色 rgb(4,255,255) */
QLabel[mode="40px,colour4,255,255"],
QLabel[mode="40px,colour4,255,255,AlignCenter"],
QLabel[mode="38px,colour4,255,255"],
QLabel[mode="38px,colour4,255,255,AlignCenter"],
QLabel[mode="30px,colour4,255,255"]                                               { color: rgb(4, 255, 255); }

/* 白色 rgb(255,255,255) */
QLabel[mode="40px,colour255,255,255"],
QLabel[mode="40px,colour255,255,255,AlignCenter"],
QLabel[mode="38px,colour255,255,255"],
QLabel[mode="38px,colour255,255,255,AlignCenter"],
QLabel[mode="30px,colour255,255,255"],
QLabel[mode="30px,colour255,255,255,font-weight: normal"],
QLabel[mode="20px,colour255,255,255"]                                             { color: rgb(255, 255, 255); }

/* 红色 rgb(252,86,78) */
QLabel[mode="100px,colour252,86,78"],
QLabel[mode="80px,colour252,86,78"]                                               { color: rgb(252, 86, 78); }

/* 绿色 rgb(22,226,58) */
QLabel[mode="160px,colour22,226,58"]                                              { color: rgb(22, 226, 58); }

/* 蓝色 rgb(63,184,248) */
QLabel[mode="100px,colour63,184,248"]                                             { color: rgb(63, 184, 248); }

/* 灰色 rgb(172,181,197) */
QLabel[mode="60px,colour172,181,197"],
QLabel[mode="20px,colour172,181,197"],
QLabel[mode="20px,colour172,181,197,AlignLeft"],
QLabel[mode="30px,colour172,181,197,AlignRight"],
QLabel[mode="20px,colour172,181,197,AlignTop"],
QLabel[mode="18px,colour172,181,197"]                                             { color: rgb(172, 181, 197); }

/* 浅灰 rgb(216,225,234) */

QLabel[mode="20px,colour216,225,234"]                                             { color: rgb(216, 225, 234); }

/* 半透明白 rgba(255,255,255,114) */
QLabel[mode="20px,colour255,255,255,114"]                                         { color: rgba(255, 255, 255, 114); }

/* ======================== 对齐方式 ======================== */

/* 居中 */
QLabel[mode="160px,colour22,226,58"],
QLabel[mode="100px,colour252,86,78"],
QLabel[mode="100px,colour63,184,248"],
QLabel[mode="80px,colour252,86,78"],
QLabel[mode="60px,colour172,181,197"],
QLabel[mode="40px,colour4,255,255,AlignCenter"],
QLabel[mode="40px,colour255,255,255,AlignCenter"],
QLabel[mode="38px,colour4,255,255,AlignCenter"],
QLabel[mode="38px,colour255,255,255,AlignCenter"],
QLabel[mode="20px,colour172,181,197"],
QLabel[mode="20px,colour255,255,255"],
QLabel[mode="20px,colour216,225,234"],
QLabel[mode="18px,colour172,181,197"]                                             { qproperty-alignment: 'AlignCenter'; }

/* 右对齐 + 垂直居中 */
QLabel[mode="40px,colour4,255,255"],
QLabel[mode="40px,colour255,255,255"],
QLabel[mode="38px,colour4,255,255"],
QLabel[mode="38px,colour255,255,255"],
QLabel[mode="30px,colour172,181,197,AlignRight"],
QLabel[mode="20px,colour255,255,255,114"]                                         { qproperty-alignment: 'AlignRight | AlignVCenter'; }

/* 左对齐 + 垂直居中 */
QLabel[mode="30px,colour4,255,255"],
QLabel[mode="20px,colour172,181,197,AlignLeft"],
QLabel[mode="30px,colour255,255,255,font-weight: normal"],
QLabel[mode="30px,colour255,255,255"]                                             { qproperty-alignment: 'AlignLeft | AlignVCenter'; }
/* 左对齐 + 垂直靠上 */
QLabel[mode="20px,colour172,181,197,AlignTop"]                                    { qproperty-alignment: 'AlignLeft | AlignTop'; }

QLabel[mode="30px,colour255,255,255,font-weight: normal"]                          {font-weight: normal;}
