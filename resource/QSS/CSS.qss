/*  ---- SET-------   */
QLabel[mode="Label_SET"] { background-image: url(:/Set/Group 10402.png); }

QTabWidget, QTabWidget::pane {
    background: transparent;
    border: none;
}

QTabBar::tab {
    width: 176px;
    height: 66px;
    border: none;
    background-image: url(:/Set/Group 10802.png);
    background-repeat: no-repeat;
    background-position: center;
    color: rgb(255,255,255);
    font-family: "Source Han Sans CN";
    font-size: 30px;
    font-weight: bold;
    text-align: center;
    margin-right: 10px;
}
QTabBar::tab:selected { background-image: url(:/Set/Group 10810.png); }
QTabBar::tab:pressed { background-image: url(:/Set/Group 10802.png); }

QTabWidget::pane {
    background-image: url(:/Set/Group 10783.png);
    background-repeat: no-repeat;
    background-position: center;
}
QLabel[mode1="Trumpet_Label"] { border-image: url(:/Sound/Group 10815.png); }

