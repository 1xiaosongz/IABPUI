   border-image:url(:/Set/Group 10815.png);
}


/*-------时间日期-----*/
QWidget#Header_Widget
{
    background:black;
}
QPushButton#Month_Button
{
    color:white;
    border:none;
    background:transparent;
    font-size:22px;
    text-align:left;
}
QPushButton#Prev_Button,
QPushButton#Next_Button
{
    color:#0094ff;
    border:none;
    background:transparent;
    font-size:24px;
}
QCalendarWidget QAbstractItemView
{
    background-color: black;
    color: white;
    selection-background-color: #0078D7;
    selection-color: white;
    font-size: 18px;
}
QCalendarWidget QTableView
{
    background-color: black;
    color: white;
    alternate-background-color: black;
}
QCalendarWidget QTableView:item:selected
{
    background-color: #0078D7; /* 选中时的蓝色背景 */
    color: white;              /* 选中时的白色文字 */
}
QCalendarWidget QAbstractItemView:disabled
{
    color: black;
}
/*-----时间------*/

QListWidget
{
    border:none;
    background:black;
    color:white;
    font-size:20px "Source Han Sans CN";
    outline:none;
}

QListWidget::item
{
    height:60px;
}

QListWidget::item:selected
{
    background:transparent;
    color:white;
}

QFrame#TopLine,
QFrame#BottomLine
{
    background:white;
    min-height:1px;
    max-height:1px;
}


















/* 整个滑动条的基底轨道 */
QSlider::groove:horizontal {
    border: none;
    height: 24px; /* 根据你的需求调整高度 */
    background: #D9D9D9; /* 右侧未填充部分的浅灰色 */
    border-radius: 12px; /* 圆角大小，通常为高度的一半 */
}

/* 左侧已填充（划过）的轨道：实现渐变色 */
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2C5E8A,  /* 左侧深蓝 */
                                stop:0.5 #00B4D8, /* 中间青蓝 */
                                stop:1 #00F5FF);  /* 右侧亮青 */
    border-radius: 12px;
}

/* 滑块（Thumb）的样式 */
QSlider::handle:horizontal {
    background: #5B92E5; /* 滑块的蓝色 */
    width: 14px;         /* 滑块的宽度 */
    margin-top: -4px;    /* 让滑块高度超出轨道，往上突出一截 */
    margin-bottom: -4px; /* 让滑块高度超出轨道，往下突出一截 */
    border-radius: 2px;  /* 微微的圆角，呈现长方形 */
}



















