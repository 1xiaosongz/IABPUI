QPushButton[mode="down_arrow_True"]  { background-image: url(:/LineOfReference/Group 10868.png); }
QPushButton[mode="down_arrow_False"] { background-image: url(:/LineOfReference/Group 10886.png); }
QLabel[mode="Digit_Frame"]           { background-image: url(:/LineOfReference/Group 10174.png); }
QPushButton#Dial_Button[mode="Dial_Button"] { background-image: url(:/WaveformSeparation/Group 10895.png); }

QWidget#HorizontalReferenceLine { background: black; }
QDial#Dial { background: transparent; border: none; }

/*-------时间日期-----*/
QWidget#Header_Widget { background: rgb(62, 67, 78); }

QPushButton#Month_Button {
    color: white;
    border: none;
    background: transparent;
    font-size: 22px;
    text-align: left;
}

QPushButton#Prev_Button,
QPushButton#Next_Button {
    color: #0094ff;
    border: none;
    background: transparent;
    font-size: 24px;
}

QCalendarWidget QAbstractItemView,
QCalendarWidget QTableView {
    background-color: rgb(62, 67, 78);
    color: white;
}

QCalendarWidget QAbstractItemView {
    selection-background-color: #0078D7;
    selection-color: white;
    font-size: 18px;
}

QCalendarWidget QTableView {
    alternate-background-color: rgb(62, 67, 78);
    border-radius: 0px;
    border: none;
}

QCalendarWidget QTableView:item:selected {
    background-color: #0078D7;
    color: white;
}

QCalendarWidget QAbstractItemView:disabled { color: rgb(62, 67, 78); }

/*-----时间列表------*/
QListWidget {
    border: none;
    background: rgb(62, 67, 78);
    color: white;
    font-size: 22px;
    font-family: "Source Han Sans CN";
    outline: none;
}
QListWidget::item { height: 60px; }
QListWidget::item:selected { background: transparent; color: white; }

QFrame#TopLine,
QFrame#BottomLine {
    background: white;
    min-height: 1px;
    max-height: 1px;
}

QPushButton[objectName^="Set_Button_"] {
    font-size: 30px;
    color: rgb(255, 255, 255);
    text-align: center;
    background-color: transparent;
    font-family: "Source Han Sans CN";
    font-weight: bold;
}
QPushButton[mode="Set_Button_Back"] { background-image: url(:/Set/Group 10795.png); }

QStackedWidget#stackedWidget > QWidget {
    background-image: url(":/Set/Group 10782.png");
    background-repeat: no-repeat;
    background-position: center;
}
QPushButton#Set_Confirm_Button[mode="Set_Confirm_Button"] { background-image: url(:/Set/Group 10791.png); }

/* 滑动条 */
QSlider::groove:horizontal {
    border: none;
    height: 24px;
    background: #D9D9D9;
    border-radius: 12px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2C5E8A, stop:0.5 #00B4D8, stop:1 #00F5FF);
    border-radius: 12px;
}
QSlider::handle:horizontal {
    background: #5B92E5;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 2px;
}

/*  ---- Statusbar / Topbar -------   */
QLabel[mode="Label_StatusBar"] { background-image: url(:/StatusBar/Group 10448.png); }
QLabel[mode="Label_Topbar"]    { background-image: url(:/TopBar/Rectangle 2846.png); }

QPushButton#AlarmBell_Button[mode="AlarmBell_Button_False"] { background-image: url(:/TopBar/Group 9904.png); }
QPushButton#AlarmBell_Button[mode="AlarmBell_Button_True"]  { background-image: url(:/TopBar/Group 10503.png); }

QLabel[mode="HeliumGasCylinderIcon_100"] { background-image: url(:/TopBar/Frame 10039.png); }
QLabel[mode="HeliumGasCylinderIcon_50"]  { background-image: url(:/TopBar/Group 10289.png); }
QLabel[mode="HeliumGasCylinderIcon_20"]  { background-image: url(:/TopBar/Group 10290.png); }
QLabel[mode="HeliumGasCylinderIcon_0"]   { background-image: url(:/TopBar/Group 10295.png); }

QLabel[mode="BatteryIcon_100"]     { background-image: url(:/TopBar/Group 9906.png); }
QLabel[mode="BatteryIcon_50"]      { background-image: url(:/TopBar/Group 10291.png); }
QLabel[mode="BatteryIcon_20"]      { background-image: url(:/TopBar/Group 10292.png); }
QLabel[mode="BatteryIcon_0"]       { background-image: url(:/TopBar/Group 10296.png); }
QLabel[mode="BatteryIcon_Recharge"] { background-image: url(:/TopBar/Group 10305.png); }

QLabel[mode="PatternIcon_Hybrid"]  { background-image: url(:/TopBar/Group 10648.png); }
QLabel[mode="PatternIcon_Rescue"]  { background-image: url(:/TopBar/Group 10645.png); }

/*  ---- TriggerMode-------   */
QLabel[mode="Label_TriggerMode"] { background-image: url(:/TriggerMode/Group 10516.png); }
QLabel[mode="Background_True"]    { background-image: url(:/TriggerMode/Rectangle 4581.png); }
QLabel[mode="Background_False"]   { background-image: none; }

/*-----------HelpInterface---------*/
QLabel#HelpInterfaceLabel[mode="HelpInterfaceLabel"] { background-image: url(:/HelpInterface/Union.png); }

/* 垂直滚动条 */
QScrollArea#scrollArea QScrollBar:vertical {
    background: #1E1E1E;
    width: 10px;
    margin: 0px;
    border: none;
}
QScrollArea#scrollArea QScrollBar::handle:vertical {
    background: #666666;
    min-height: 40px;
    border-radius: 5px;
}
QScrollArea#scrollArea QScrollBar::handle:vertical:hover   { background: #888888; }
QScrollArea#scrollArea QScrollBar::handle:vertical:pressed { background: #AAAAAA; }

QScrollArea#scrollArea QScrollBar::add-line:vertical,
QScrollArea#scrollArea QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}
QScrollArea#scrollArea QScrollBar::add-page:vertical,
QScrollArea#scrollArea QScrollBar::sub-page:vertical {
    background: none;
}

/*-----------数据导出日志相关---------*/
QLabel[mode="Label11"]                   { background-image: url(:/LogExport/Group 10944.png); }
QLabel[mode="Label_DataPanel_Background"] { background-image: url(:/LogExport/Group 109471.png); }
QLabel[mode="Label_Top_Background"]      { background-image: url(:/LogExport/Group 10947.png); }
QLabel[mode="PageLabel"]                  { background-image: url(:/LogExport/Group 10981.png); }
QLabel[mode="Label_Time"]                 { background-image: url(:/LogExport/Group 10971.png); }

QWidget#TableListPanel {
    border: none;
    background-repeat: no-repeat;
    background-position: center;
    background-color: transparent;
}

/* 滚动区域透明 */
QScrollArea#TableScrollArea,
QScrollArea#TableScrollArea > QWidget > QWidget,
QScrollArea#MyScrollArea #ScrollAreaWidgetContents {
    border: none;
    background-color: transparent;
    background-image: none;
}

QPushButton[objectName^="BtnTable_"] {
    outline: none;
    border: none;
    background-repeat: no-repeat;
    background-position: center;
    background-color: transparent;
    font-family: "Source Han Sans CN";
    font-weight: bold;
    font-size: 25px;
    color: rgb(255, 255, 255);
}
QPushButton[objectName^="BtnTable_"]:pressed,
QPushButton[objectName^="BtnTable_"]:checked {
    background-image: url(:/LogExport/Frame 40711.png);
}

QPushButton[mode="RefreshButton"] { border-image: url(:/LogExport/Group 10977.png); }
QPushButton[mode="RefreshButton"]:pressed { border-image: url(:/LogExport/Group 10976.png); }
QPushButton[mode="Left_Button"]   { border-image: url(:/LogExport/Group 10969.png); }
QPushButton[mode="Left_Button"]:pressed { border-image: url(:/LogExport/Group 10978.png); }
QPushButton[mode="Right_Button"]  { border-image: url(:/LogExport/Group 10970.png); }
QPushButton[mode="Right_Button"]:pressed { border-image: url(:/LogExport/Group 10979.png); }
QPushButton[mode="Export_Button"] { border-image: url(:/LogExport/Group 10982.png); }
QPushButton[mode="Export_Button"]:pressed { border-image: url(:/LogExport/Group 10968.png); }
QPushButton[mode="LogExport_Close_Button"] { border-image: url(:/LogExport/Group 11001.png); }
QPushButton[mode="LogExport_Close_Button"]:pressed { border-image: url(:/LogExport/Group 10928.png); }

/* ========================================================================
   QTableView 样式组
   ======================================================================== */
QTableView {
    background-color: #191c24;
    alternate-background-color: #1f232d;
    color: #e3e3e3;
    gridline-color: transparent;
    outline: none;
    border: none;
    font-family: "Source Han Sans CN";
    font-size: 20px;
    border-radius: 20px;
    font-weight: bold;
    padding: 0px;
}

QHeaderView {
    background-color: #1f232d;
    border-top: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #22B6B6, stop:1 #04FFFF);
    border-bottom: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #22B6B6, stop:1 #04FFFF);
}

QHeaderView::section {
    background-color: #1f232d;
    color: #e3e3e3;
    padding: 10px;
    border: none;
    font-size: 20px;
    font-weight: bold;
}
QHeaderView::section:horizontal:first { border-top-left-radius: 20px; }
QHeaderView::section:horizontal:last  { border-top-right-radius: 20px; }

/* 表格水平滚动条 */
QScrollBar:horizontal {
    border: none;
    background: #191c24;
    height: 12px;
    margin: 0px 20px;
}
QScrollBar::handle:horizontal {
    background: #2c313d;
    min-width: 30px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #00b4d8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; height: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

QTableView::item { padding: 10px; }
QTableView::item:selected { background-color: #2a313e; color: #00b4d8; }
QTableView::item:hover    { background-color: #232935; }

/* ========================================================
   QComboBox 下拉组件
   ======================================================== */
QComboBox#LineNumberComboBox {
    font-family: "Source Han Sans CN";
    font-size: 28px;
    font-weight: bold;
    color: white;
    background-color: transparent;
    border: none;
    background-image: url(:/LogExport/Group 10973.png);
    background-repeat: no-repeat;
    background-position: center;
    padding: 0px;
    min-width: 93px;
    max-width: 93px;
    min-height: 60px;
    max-height: 60px;
}
QComboBox#LineNumberComboBox::drop-down { border: none; width: 0px; }
QComboBox#LineNumberComboBox::down-arrow { image: none; }

QComboBox#LineNumberComboBox QAbstractItemView {
    font-family: "Source Han Sans CN";
    font-size: 26px;
    color: white;
    background-color: #252932;
    border: none;
    border-radius: 8px;
    padding: 6px;
    outline: none;
}
QComboBox#LineNumberComboBox QAbstractItemView::item {
    height: 30px;
    margin: 5px 2px;
    border-radius: 6px;
    padding-left: 0px;
    color: white;
    background-color: #3E4552;
}
QComboBox#LineNumberComboBox QAbstractItemView::item:hover,
QComboBox#LineNumberComboBox QAbstractItemView::item:selected {
    background-color: #21B7BE;
    color: white;
}

/* ========================================================
   QLineEdit 输入框与自动补全弹窗
   ======================================================== */
QLineEdit[mode="Patient_ID"] {
    background-image: url(:/LogExport/Group 10975.png);
    font-family: "Source Han Sans CN";
    font-size: 22px;
    color: rgb(4, 255, 255);
    padding-left: 10px;
    background-color: #2D3035;
    border: 1px solid #3E4248;
    border-radius: 4px;
    font-weight: bold;
}
QLineEdit[mode="Patient_ID"]:focus { border: 1px solid #22B0AF; }

QAbstractItemView#PatientCompleterPopup,
QAbstractItemView#PatientCompleterPopup QAbstractScrollArea,
QAbstractItemView#PatientCompleterPopup QAbstractScrollArea viewport {
    background-color: #252932;
}

QAbstractItemView#PatientCompleterPopup { border: none; }

QAbstractItemView#PatientCompleterPopup::item {
    background-color: #31353D;
    color: white;
    height: 35px;
    margin: 3px;
    border-radius: 5px;
    font-family: "Source Han Sans CN";
    font-size: 20px;
}
QAbstractItemView#PatientCompleterPopup::item:hover,
QAbstractItemView#PatientCompleterPopup::item:selected {
    background-color: #22B0AF;
}