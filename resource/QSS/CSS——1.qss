/* ========================================================================
   1. 表格整体样式（已修改为 20px 圆角）
   ======================================================================== */
QTableView {
    background-color: #191c24;          /* 整体大背景：深暗色 */
    alternate-background-color: #1f232d;/* 隔行变色的深灰 */
    color: #e3e3e3;                     /* 正常文字颜色：浅白 */
    gridline-color: transparent;        /* 隐藏原生网格线 */
    outline: none; /* 👈 核心：干掉焦点线 */
    border: none;
    font-family: "Source Han Sans CN";
    font-size: 20px;
    border-radius: 20px;                /* 核心：给表格本身设置 20px 圆角 */
    font-weight: bold;
    padding: 0px;
}

/* ========================================================================
   2. 表头样式：左上角和右上角裁剪为 20px 圆角
   ======================================================================== */
QHeaderView::section:horizontal:first {
    border-top-left-radius: 20px;
}
QHeaderView::section:horizontal:last {
    border-top-right-radius: 20px;
}

QHeaderView {
    background-color: #1f232d;
    border: none;
}
QHeaderView::section {
    background-color: #1f232d;
    color: #e3e3e3;
    padding: 4px;
    border: none;
    font-size: 20px;
}

/* ========================================================================
   3. 新增：水平滚动条样式（完美适配你的 13 列数据与暗黑风格）
   ======================================================================== */
/* 整个水平滚动条区域 */
QScrollBar:horizontal {
    border: none;
    background: #191c24;                /* 与表格大背景一致 */
    height: 12px;                       /* 滚动条高度 */
    margin: 0px 20px 0px 20px;          /* 左右留出距离，防止滑块顶到表格的20px圆角边框 */
}

/* 滚动条上的滑块 */
QScrollBar::handle:horizontal {
    background: #2c313d;                /* 滑块颜色：稍微亮一点的深灰 */
    min-width: 30px;
    border-radius: 6px;                 /* 滑块自身的圆角 */
}

/* 鼠标悬浮在滑块上时的颜色 */
QScrollBar::handle:horizontal:hover {
    background: #00b4d8;                /* 悬浮时变成高亮青蓝色，呼应你的ID高亮色 */
}

/* 隐藏滚动条左右两端的自带箭头 */
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}

/* 滚动条滑块两边的空白轨道背景（保持透明，露出表格背景） */
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 选中行样式 */
QTableView::item:selected {
    background-color: #2a313e;          /* 选中行高亮成略带深蓝的灰色 */
    color: #00b4d8;                     /* 选中行的文字变成高亮青蓝 */
}

/* 鼠标悬停行样式 */
QTableView::item:hover {
    background-color: #232935;          /* 鼠标悬停变色 */
}
/* 为表格的每一个格子单元格添加内边距 */
QTableView::item {
    padding-left: 10px;   /* 文字距离左边框 10px */
    padding-right: 10px;  /* 文字距离右边框 10px */
    padding-top: 10px;     /* 文字距离上边框 5px */
    padding-bottom: 10px;  /* 文字距离下边框 5px */
}
/* 表头（Header）样式 */
/* 1. 作用于整个表头视图：在这里设置贯穿整行的上下渐变边框 */
QHeaderView {
    background-color: #1f232d;          /* 确保表头整体背景色一致 */
    /* 上边框整条渐变 (从左到右) */
    border-top: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #22B6B6, stop:1 #04FFFF);
    /* 下边框整条渐变 (从左到右) */
    border-bottom: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #22B6B6, stop:1 #04FFFF);
}

/* 2. 作用于表头内部的每个格子 */
QHeaderView::section {
    background-color: #1f232d;          /* 表头格子用 #1f232d */
    color: #e3e3e3;                     /* 表头文字颜色 */
    padding: 10px;
    /* 必须清除每个格子自带的边框，否则会遮挡或破坏外层 QHeaderView 的渐变线 */
    border: none;
    font-weight: bold;
    font-size: 20px;
}


/* ===============================
   LineNumberComboBox 主体
   =============================== */
QComboBox#LineNumberComboBox {
    font-family: "Source Han Sans CN";
    font-size: 28px;
    font-weight: bold;
    color: white;
    background-color: transparent;
    border: none;
    background-image: url(:/LogExport/Group 10973.png);
    background-repeat: no-repeat;
    background-position: center;
    padding-left: 0px;
    padding-right: 0px;
   /* 1. 设置宽度（根据你的切图微调数值） */
       min-width: 93px;  /* 限制最小宽度 */
       max-width: 93px;  /* 限制最大宽度 */

       /* 2. 设置高度（你原本是 40px，如果需要改动直接在这里修改） */
       min-height: 60px;  /* 限制最小高度 */
       max-height: 60px;  /* 限制最大高度 */
}

/* 去掉右侧三角按钮 */
QComboBox#LineNumberComboBox::drop-down {
    border: none;
    width: 0px;
}
QComboBox#LineNumberComboBox::down-arrow {
    image: none;
}

/* ========================================================
   下拉列表外层（现在可以安全地设置整体深色背景和完美大圆角了）
   ======================================================== */
QComboBox#LineNumberComboBox QAbstractItemView {
    font-family: "Source Han Sans CN";
    font-size: 26px;
    color: white;

    /* 核心：配合 C++ 的透明属性，这里才是真正的下拉弹窗大背景 */
    background-color: #252932;
    border: none ;
    border-radius: 8px; /* 整个弹窗的大圆角 */
    padding: 6px;
    outline: none;
}

QComboBox#LineNumberComboBox QAbstractItemView::item {
/* 1. 【核心】在这里设置每一个选项格子的长度（宽） */
    height: 30px;
    margin: 5px 2px;
    border-radius: 6px; /* 单个选项的内圆角 */
    padding-left: 0px;  /* 配合 C++ 居中 */
    color: white;
    background-color: #3E4552;
}

/* 鼠标经过 */
QComboBox#LineNumberComboBox QAbstractItemView::item:hover {
    background-color: #21B7BE;
    color: white;
}

/* 当前选中 */
QComboBox#LineNumberComboBox QAbstractItemView::item:selected {
    background-color: #21B7BE;
    color: white;
}

/* 1. 输入框 Patient_ID 基础样式 */
QLineEdit[mode="Patient_ID"] {
    background-image:url(:/LogExport/Group 10975.png);
    font-family: "Source Han Sans CN";
    font-size: 22px;             /* 在这里调整字体大小 */
    color:rgb(4, 255, 255);                /* 输入框文字颜色 */
    padding-left: 10px;          /* 适当加点左边距，防止文字紧贴背景图边缘 */
    background-color: #2D3035;    /* 深灰色背景 */
    border: 1px solid #3E4248;    /* 暗色边框 */
    border-radius: 4px;           /* 圆角 */
font-weight: bold;
}

QLineEdit[mode="Patient_ID"]:focus {
    border: 1px solid #22B0AF;    /* 聚焦时显示为你图一的蓝绿色边框 */
}

/* QCompleter整体弹窗 */
QAbstractItemView#PatientCompleterPopup
{
    background-color:#252932;
    border:none;

}
/* 真正显示背景的位置 */
QAbstractItemView#PatientCompleterPopup QAbstractScrollArea
{
    background-color:#252932;
}
QAbstractItemView#PatientCompleterPopup QAbstractScrollArea viewport
{
    background-color:#252932;
}
/* item */
QAbstractItemView#PatientCompleterPopup::item
{
    background-color:#31353D;
    color:white;
    height:35px;
    margin:3px;
    border-radius:5px;
    font-family: "Source Han Sans CN";                   /* 设置字体，优先微软雅黑 */
    font-size: 20px;                                         /* 设置字号大小，可以根据需要调整 */

}
QAbstractItemView#PatientCompleterPopup::item:hover,
QAbstractItemView#PatientCompleterPopup::item:selected
{
    background-color:#22B0AF;

}