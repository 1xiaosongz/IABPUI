    border: none;
    background-color: transparent;
    background-image: none;
}
/* 2. 把滚动区域内部包裹的那个滚动组件（Widget）也设为透明 */
QScrollArea#MyScrollArea #ScrollAreaWidgetContents {
    background-color: transparent;
}

