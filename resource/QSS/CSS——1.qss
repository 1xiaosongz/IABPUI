/*  Inflation_Deflation_Timing  */

QPushButton#Finish_Button {
   border:none;
    background-color:transparent;
    background-image: url(:/Inflation_Deflation_Timing/Group 10257.png);
}

QPushButton#Finish_Button:pressed {
    background-image: url(:/Inflation_Deflation_Timing/Group 10286.png);
}
