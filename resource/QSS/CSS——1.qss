/* 意思是：找到 objectName 为 stackedWidget 的控件，并给它里面所有的子 QWidget 加上背景 */
QStackedWidget#stackedWidget > QWidget {
    background-image: url(":/Set/Group 10782.png"); /* 你的图片路径 */
    background-repeat: no-repeat;                     /* 背景图不重复平铺 */
    background-position: center;                      /* 背景图居中显示 */
}
QPushButton#Set_Confirm_Button[mode = "Set_Confirm_Button"]{
    background-image:url(:/Set/Group 10791.png);
}
/* 整个滑动条的基底轨道 */
QSlider::groove:horizontal {
    border: none;
    height: 24px; /* 根据你的需求调整高度 */
    background: #D9D9D9; /* 右侧未填充部分的浅灰色 */
    border-radius: 12px; /* 圆角大小，通常为高度的一半 */
}
/* 左侧已填充（划过）的轨道：实现渐变色 */
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2C5E8A,  /* 左侧深蓝 */
                                stop:0.5 #00B4D8, /* 中间青蓝 */
                                stop:1 #00F5FF);  /* 右侧亮青 */
    border-radius: 12px;
}

/* 滑块（Thumb）的样式 */
QSlider::handle:horizontal {
    background: #5B92E5; /* 滑块的蓝色 */
    width: 14px;         /* 滑块的宽度 */
    margin-top: -4px;    /* 让滑块高度超出轨道，往上突出一截 */
    margin-bottom: -4px; /* 让滑块高度超出轨道，往下突出一截 */
    border-radius: 2px;  /* 微微的圆角，呈现长方形 */
}

