  background-image:url(:/Inflation_Deflation_Timing/Group 10532.png);
}
QPushButton#Help_Button[mode="Help_Button"] {
   background-image:url(:/Inflation_Deflation_Timing/Group 10259.png);
}
/* 减号按钮 */
QPushButton[mode="Reduce"]{
    background-image:url(:/Inflation_Deflation_Timing/Group 10533.png);
}
QPushButton[mode="Reduce"]:pressed{
    background-image:url(:/Inflation_Deflation_Timing/Group 10445.png);
}
/* 加号按钮 */
QPushButton[mode="Add"]{
    background-image:url(:/Inflation_Deflation_Timing/Group 10534.png);
}
QPushButton[mode="Add"]:pressed{
    background-image:url(:/Inflation_Deflation_Timing/Group 10446.png);
}
